rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /customers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'phoneNumber', 'points', 'createdAt',
          'shippingGov', 'shippingAddress'
        ])
        && request.resource.data.phoneNumber == request.auth.token.phone_number
        && (!('points' in request.resource.data) || request.resource.data.points == 0);

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'shippingGov', 'shippingAddress'
          ]));

      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if request.resource.data.keys().hasOnly([
          'uid', 'customer', 'phone', 'gov', 'address', 'notes',
          'items', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'customer', 'phone', 'gov', 'address', 'notes',
          'items', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.customer is string
        && request.resource.data.customer.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.gov is string
        && request.resource.data.gov.size() > 0
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.createdAt is timestamp
        && ((signedIn() && request.resource.data.uid == request.auth.uid)
          || (!signedIn() && request.resource.data.uid == null));

      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
